#!/bin/bash
#PBS -N fixed_acoustic_alpha
#PBS -q workq
#PBS -l nodes=1:ppn=8
#PBS -l mem=128gb
#PBS -l walltime=24:00:00
#PBS -o results/logs/${PBS_JOBID}_fixed_acoustic_alpha.log
#PBS -j oe

set -euo pipefail
cd "$PBS_O_WORKDIR"

JOBTAG="${PBS_JOBID:-$(date +%s)}"
export JULIA_NUM_THREADS=8
JULIA_BIN="${JULIA_BIN:-$HOME/.juliaup/bin/julia}"

echo "Job [$JOBTAG] started on $(hostname) at $(date)"
echo "Config: configs/fixed_acoustic_alpha.toml"

mkdir -p results/logs

"$JULIA_BIN" --project=. --threads=$JULIA_NUM_THREADS \
    examples/compute_modal_energies.jl configs/fixed_acoustic_alpha.toml

RC=$?
echo "Job finished with code: $RC at $(date)"
exit $RC
